# Copy to .env; npm commands use --env-file=.env (see README).
HOST_PASSWORD=replace-with-a-private-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Required in production. Use the provider's pooled PostgreSQL URL, with TLS.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Exact public app URL; QR codes use this. No trailing slash.
PUBLIC_URL=http://localhost:3000
# Local rehearsal only; file-backed SQLite, no demo answers preassigned.
SQLITE_PATH=data/rehearsal.sqlite
PORT=3000
# Optional for a reverse proxy that preserves /tasting in requests.
# BASE_PATH=/tasting
